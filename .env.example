# Melhor Envio OAuth2
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=https://SEU-DOMINIO/api/public/melhor-envio/callback

# 32 bytes: 64 hexadecimal characters OR a base64 value that decodes to 32 bytes.
MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY=

# Long random secret used to sign the OAuth state parameter.
MELHOR_ENVIO_OAUTH_STATE_SECRET=

# Optional. Must identify the application and include a technical contact email.
MELHOR_ENVIO_USER_AGENT=Massa do Lucao (interativasms@gmail.com)
